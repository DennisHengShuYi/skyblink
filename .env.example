# SkyBlink needs no secrets. All of these are optional overrides.

# SPHEREx releases to search, highest priority first. Add new releases at the front.
SKYBLINK_COLLECTIONS=spherex_dr1,spherex_qr3

# Live builds on Vercel: max images per build and time budget in seconds.
SKYBLINK_LIVE_MAX_VISITS=40
SKYBLINK_LIVE_BUDGET_S=240

# Simultaneous cutout downloads from IRSA (lower this if IRSA returns 503).
SKYBLINK_CONCURRENCY=10

# Visit cap for local server / featured builds, raw cutout cache size (MB), cache folder.
SKYBLINK_MAX_VISITS=80
SKYBLINK_RAW_CACHE_MB=4000
# SKYBLINK_CACHE=./cache
